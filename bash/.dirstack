function cd() {
    if [ $# -eq 0 ]; then
	dir="${HOME}"
    else
        dir="$1"
    fi

    builtin pushd $(readlink -f $dir) &> /dev/null
}


function up_dirstack() {
    cd $(dirs -l +$1)
}

alias d='dirs -v | head -10'
alias 1='up_dirstack 1'
alias 2='up_dirstack 2'
alias 3='up_dirstack 3'
alias 4='up_dirstack 4'
alias 5='up_dirstack 5'
alias 6='up_dirstack 6'
alias 7='up_dirstack 7'
alias 8='up_dirstack 8'
alias 9='up_dirstack 9'
