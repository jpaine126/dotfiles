cp_softlink () {
    SOURCE_DIR="$1"
    DEST_DIR="$2"

    # Check if source directory exists
    if [ ! -d "$SOURCE_DIR" ]; then
        echo "Error: Source directory '$SOURCE_DIR' does not exist."
        exit 1
    fi

    # Create the destination directory if it doesn't exist
    mkdir -pv "$DEST_DIR"

    # Find all files and directories in the source, then create corresponding structure and symlinks
    find "$SOURCE_DIR" -print0 | while IFS= read -r -d $'\0' item; do
        relative_path="${item#$SOURCE_DIR/}" # Get path relative to SOURCE_DIR
        target_path="$DEST_DIR/$relative_path"
    
        if [ -d "$item" ]; then
            # If it's a directory, create it in the destination
            mkdir -pv "$target_path"
        elif [ -f "$item" ]; then
            # If it's a file, create a symbolic link to it
            ln -svf "$item" "$target_path"
        fi
    done
}

sha_archive () {
    find_dir=$(readlink -f .)
    output_file="$(basename $find_dir).sha256"
    echo "writing sha's to $output_file"
    find . -type f -not -name $output_file -exec sha256sum {} \; | tee $output_file
    sha256sum $output_file | tee $output_file.sha256
    echo done
}

archive_check () {
    output_file="$(basename $(readlink -f .)).sha256"
    echo "Checking archive $output_file ..."
    sha256sum -c $output_file.sha256
    sha256sum -c $output_file
    echo done
}

# k8s

prune_dead_pods () {
    NAMESPACE="${1:-default}"
    DRY_RUN="${DRY_RUN:-false}"

    EXTRA_FLAGS=()
    if [ "$DRY_RUN" = "true" ]; then
        EXTRA_FLAGS+=("--dry-run=client")
    fi

    if [ "$NAMESPACE" = "all" ] || [ "$NAMESPACE" = "-A" ]; then
        echo "Deleting non-running pods across all namespaces..."
        kubectl delete pods --field-selector status.phase!=Running -A "${EXTRA_FLAGS[@]}"
    else
        echo "Deleting non-running pods in namespace $NAMESPACE..."
        kubectl delete pods --field-selector status.phase!=Running -n "$NAMESPACE" "${EXTRA_FLAGS[@]}"
    fi
}
