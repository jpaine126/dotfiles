"General
set nocompatible
set mouse=a

"colors
colorscheme slate
"UI
set nowrap
set cursorline
set number
set showcmd
set relativenumber
set showmatch
syntax enable
set wildmenu

"Searching
set expandtab
set tabstop=4
set softtabstop=4
set shiftwidth=4

"folding
set foldenable

"backup
set nobackup
set noswapfile
