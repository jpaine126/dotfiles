cp_softlink () {
    SOURCE_DIR="$1"
    DEST_DIR="$2"

    # Check if source directory exists
    if [ ! -d "$SOURCE_DIR" ]; then
        echo "Error: Source directory '$SOURCE_DIR' does not exist."
        exit 1
    fi

    # Create the destination directory if it doesn't exist
    mkdir -pv "$DEST_DIR"

    # Find all files and directories in the source, then create corresponding structure and symlinks
    find "$SOURCE_DIR" -print0 | while IFS= read -r -d $'\0' item; do
        relative_path="${item#$SOURCE_DIR/}" # Get path relative to SOURCE_DIR
        target_path="$DEST_DIR/$relative_path"
    
        if [ -d "$item" ]; then
            # If it's a directory, create it in the destination
            mkdir -pv "$target_path"
        elif [ -f "$item" ]; then
            # If it's a file, create a symbolic link to it
            ln -svf "$item" "$target_path"
        fi
    done
}
